# Copy this file to .env and fill in real values. NEVER commit .env to git.

# Your Groq API key — stays on the server, never sent to browsers
GROQ_API_KEY=

# Optional: Google Gemini key, used to refine/clean scraped site content
GEMINI_API_KEY=

# Port the server listens on
PORT=3000

# Your Firebase service account key, as JSON on one line (or base64-encoded
# JSON — db/index.js accepts either). Get this from:
# Firebase Console → Project Settings → Service Accounts → Generate new
# private key. Use the SAME Firebase project your frontend's Firebase
# Hosting deploys to, so both read/write the same Firestore database.
FIREBASE_SERVICE_ACCOUNT=

# Signs the JWTs issued by POST /api/auth/login. Generate with: openssl rand -hex 32
JWT_SECRET=

# First-run bootstrap ONLY: if the database has zero owner accounts, these
# create one on startup, then are never read again. Change your password
# from the dashboard after your first login.
OWNER_EMAIL=owner@youragency.com
OWNER_PASSWORD=change-me-after-first-login
OWNER_NAME=Owner

# Max chat requests allowed per bot token per minute (protects your Groq quota per client)
RATE_LIMIT_PER_MINUTE=20

# Cloudinary — used only for the custom chat-icon image upload feature.
# The upload itself happens server-side (backend/lib/cloudinary.js), so
# these values are never exposed to the browser.
# Cloud name: Cloudinary Console dashboard, top left.
# Upload preset: Settings -> Upload -> Upload presets -> Add upload preset
#   (Signing Mode can stay "Unsigned" since the request never leaves the
#   server — auth is enforced by requireAuth on the routes that call it).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=
